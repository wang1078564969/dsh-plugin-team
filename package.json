{
  "name": "dsh-plugin-team",
  "version": "0.2.0",
  "description": "Team collaboration layer for DSH — requirements, tasks, two-stage human confirmation, leases and decisions, with tasks actually executed by real DSH sessions.",
  "author": "wangmengfan",
  "license": "MIT",
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "team",
    "requirement",
    "task",
    "feishu"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.3"
  }
}
